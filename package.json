{
  "name": "watchers-eye-market-analyzer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "predev": "npm run check:dependencies",
    "dev": "next dev",
    "prebuild": "npm run check:dependencies",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "npm run check:dependencies && npm run db:generate && npm run db:push"
  },
  "dependencies": {
    "@prisma/client": "6.8.2",
    "next": "15.3.2",
    "papaparse": "5.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.28"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.3",
    "prisma": "6.8.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  }
}
